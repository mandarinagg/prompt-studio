        "recent.list": {
          "type": "object",
          "properties": {
            "params": {
              "$ref": "#/$defs/NoParams"
            },
            "result": {
              "$ref": "#/$defs/RecentList"
            }
          },
          "required": [
            "params",
            "result"
          ],
