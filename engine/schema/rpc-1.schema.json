      "required": [
        "asset.apply_plan",
        "asset.export",
        "asset.history",
        "asset.jump",
        "asset.redo",
        "asset.reset",
        "asset.set_stack",
        "asset.state",
        "asset.undo",
        "asset.undo_group",
        "engine.version",
        "image.info",
        "ping",
        "plan.create",
        "plan.draft",
        "preview.render",
        "project.close",
        "project.create",
        "project.import",
        "project.info",
        "project.open",
        "project.relink",
        "recent.forget",
        "recent.list",
        "thumbnail.get"
      ],
