    },
    "events": {
      "title": "Events",
      "type": "object",
      "properties": {
        "thumbnail.ready": {
          "$ref": "#/$defs/ThumbnailReady"
        }
      },
      "required": [
        "thumbnail.ready"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "events",
    "methods"
  ],
  "additionalProperties": false,
  "$defs": {
    "ApplyPlanParams": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/EditPlan"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        }
      },
      "required": [
        "asset",
        "plan"
      ],
      "title": "ApplyPlanParams",
      "type": "object"
    },
    "AssetParams": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        }
      },
      "required": [
        "asset"
      ],
      "title": "AssetParams",
      "type": "object"
    },
    "AssetSummary": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "edited": {
          "title": "Edited",
          "type": "boolean"
        },
        "missing": {
          "title": "Missing",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "file",
        "edited",
        "missing"
      ],
      "title": "AssetSummary",
      "type": "object"
    },
    "AutoExposure": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "auto_exposure",
          "title": "Op",
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "AutoExposure",
      "type": "object"
    },
    "AutoWhiteBalance": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "auto_white_balance",
          "title": "Op",
          "type": "string"
        },
        "method": {
          "default": "gray_world",
          "enum": [
            "gray_world",
            "white_patch"
          ],
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "AutoWhiteBalance",
      "type": "object"
    },
    "Blacks": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "default": 0,
          "description": "-100…100; 0 = sin cambio",
          "maximum": 100,
          "minimum": -100,
          "title": "Amount",
          "type": "integer"
        },
        "op": {
          "const": "blacks",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Blacks",
      "type": "object"
    },
    "Contrast": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "default": 0,
          "description": "-100…100; 0 = sin cambio",
          "maximum": 100,
          "minimum": -100,
          "title": "Amount",
          "type": "integer"
        },
        "op": {
          "const": "contrast",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Contrast",
      "type": "object"
    },
    "CreateParams": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "minLength": 1,
          "title": "Dir",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "dir",
        "name"
      ],
      "title": "CreateParams",
      "type": "object"
    },
    "Crop": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "crop",
          "title": "Op",
          "type": "string"
        },
        "aspect_ratio": {
          "anyOf": [
            {
              "enum": [
                "1:1",
                "4:5",
                "5:4",
                "3:2",
                "2:3",
                "4:3",
                "3:4",
                "16:9",
                "9:16"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aspect Ratio"
        },
        "rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anchor": {
          "default": "center",
          "enum": [
            "center",
            "subject_or_center",
            "top",
            "bottom",
            "left",
            "right"
          ],
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "Crop",
      "type": "object"
    },
    "Denoise": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "denoise",
          "title": "Op",
          "type": "string"
        },
        "strength": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Strength",
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "Denoise",
      "type": "object"
    },
    "DraftParams": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/EditPlan"
        },
        "stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "asset",
        "plan"
      ],
      "title": "DraftParams",
      "type": "object"
    },
    "EditPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id del asset en el proyecto",
          "title": "Asset"
        },
        "source_prompt": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Prompt"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "auto_exposure": "#/$defs/AutoExposure",
                "auto_white_balance": "#/$defs/AutoWhiteBalance",
                "blacks": "#/$defs/Blacks",
                "contrast": "#/$defs/Contrast",
                "crop": "#/$defs/Crop",
                "denoise": "#/$defs/Denoise",
                "exposure": "#/$defs/Exposure",
                "highlights": "#/$defs/Highlights",
                "resize": "#/$defs/Resize",
                "rotate": "#/$defs/Rotate",
                "saturation": "#/$defs/Saturation",
                "shadows": "#/$defs/Shadows",
                "sharpen": "#/$defs/Sharpen",
                "straighten": "#/$defs/Straighten",
                "vibrance": "#/$defs/Vibrance",
                "vignette": "#/$defs/Vignette",
                "white_balance": "#/$defs/WhiteBalance",
                "whites": "#/$defs/Whites"
              },
              "propertyName": "op"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Exposure"
              },
              {
                "$ref": "#/$defs/AutoExposure"
              },
              {
                "$ref": "#/$defs/Contrast"
              },
              {
                "$ref": "#/$defs/Highlights"
              },
              {
                "$ref": "#/$defs/Shadows"
              },
              {
                "$ref": "#/$defs/Whites"
              },
              {
                "$ref": "#/$defs/Blacks"
              },
              {
                "$ref": "#/$defs/WhiteBalance"
              },
              {
                "$ref": "#/$defs/AutoWhiteBalance"
              },
              {
                "$ref": "#/$defs/Saturation"
              },
              {
                "$ref": "#/$defs/Vibrance"
              },
              {
                "$ref": "#/$defs/Crop"
              },
              {
                "$ref": "#/$defs/Rotate"
              },
              {
                "$ref": "#/$defs/Straighten"
              },
              {
                "$ref": "#/$defs/Resize"
              },
              {
                "$ref": "#/$defs/Sharpen"
              },
              {
                "$ref": "#/$defs/Denoise"
              },
              {
                "$ref": "#/$defs/Vignette"
              }
            ]
          },
          "title": "Operations",
          "type": "array"
        },
        "export": {
          "anyOf": [
            {
              "$ref": "#/$defs/Export"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "unsupported": {
          "items": {
            "$ref": "#/$defs/Unsupported"
          },
          "title": "Unsupported",
          "type": "array"
        },
        "clarification": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification"
        }
      },
      "title": "EditPlan",
      "type": "object"
    },
    "EngineVersion": {
      "properties": {
        "pstudio": {
          "title": "Pstudio",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        },
        "libvips": {
          "title": "Libvips",
          "type": "string"
        }
      },
      "required": [
        "pstudio",
        "python",
        "libvips"
      ],
      "title": "EngineVersion",
      "type": "object"
    },
    "Export": {
      "additionalProperties": false,
      "description": "Lo que no se indica sale del preset (docs/EXPORT_PRESETS.md) o de la fuente.",
      "properties": {
        "preset": {
          "anyOf": [
            {
              "enum": [
                "original",
                "high_quality",
                "web",
                "catalog_square",
                "social_vertical",
                "story_9x16"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "jpeg",
                "png",
                "webp",
                "tiff"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "color_space": {
          "anyOf": [
            {
              "enum": [
                "sRGB",
                "Display P3"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "metadata": {
          "anyOf": [
            {
              "enum": [
                "keep",
                "strip",
                "strip_gps"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        }
      },
      "title": "Export",
      "type": "object"
    },
    "ExportParams": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "preset": {
          "default": "web",
          "enum": [
            "original",
            "high_quality",
            "web",
            "catalog_square",
            "social_vertical",
            "story_9x16"
          ],
          "title": "Preset",
          "type": "string"
        },
        "out_dir": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Out Dir"
        }
      },
      "required": [
        "asset"
      ],
      "title": "ExportParams",
      "type": "object"
    },
    "Exported": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "out_dir": {
          "title": "Out Dir",
          "type": "string"
        },
        "ms": {
          "title": "Ms",
